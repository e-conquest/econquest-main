# EconQuest home server settings. Copy to .env in this folder and edit. Every line is optional.
# Data keys (FRED, EVDS, Gemini, ...) can go here or in Menu > Settings > Data API keys; the
# full list is in ../../.env.example and docs/DATA_SOURCES.md.

# Port on the server, and which address it listens on. 127.0.0.1 = this machine only.
PORT=3737
BIND_ADDRESS=127.0.0.1
# Names or addresses you type in the browser when BIND_ADDRESS is not 127.0.0.1, comma separated.
# ALLOWED_HOSTS=homeserver.local,192.168.1.20

# Where state and models live on the server. Back up DATA_PATH.
DATA_PATH=./data
OLLAMA_MODELS_PATH=./ollama

# Run Ollama in this compose project. Delete this line if Ollama runs elsewhere.
COMPOSE_PROFILES=ollama

# Ollama. The bundled service is http://ollama:11434. For Ollama elsewhere on your network,
# put its URL here (for example http://192.168.1.30:11434).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_QUICK_MODEL=qwen2.5:7b
# Referee (Supreme Council, summaries, explanations): 32B. Never an 8B model.
OLLAMA_DEEP_MODEL=qwen2.5:32b

# Time zone for the morning brief and the nightly data check, e.g. Europe/London.
TZ=UTC

# HTTPS and sign-in (docs/HOME_SERVER.md "HTTPS and sign-in"). To use them, add ",https" to
# COMPOSE_PROFILES above and set:
# SITE_ADDRESS=homeserver.local
# TLS_MODE=internal              # or your email address for a public domain (Let's Encrypt)
# ALLOWED_HOSTS=homeserver.local # the same name
# TRUST_PROXY=1
# COOKIE_SECURE=true
# Master key that encrypts the keys saved in Menu > Settings. Keep a copy somewhere else.
# Make one with: openssl rand -base64 32
# ECONQUEST_SECRET_KEY=
